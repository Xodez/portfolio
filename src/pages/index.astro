---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { skillGroups } from "../data/skills";
import { experience } from "../data/experience";
import { education } from "../data/education";
import { projects } from "../data/projects";
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={site.tagline}
>
  <!-- Hero -->
  <section
    id="top"
    class="relative scroll-mt-24 overflow-hidden bg-gradient-to-b from-slate-50 to-white dark:from-slate-900 dark:to-slate-950"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-24 mx-auto h-72 w-[34rem] max-w-full rounded-full bg-indigo-500/10 blur-3xl dark:bg-indigo-500/20"
    ></div>
    <div class="relative mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/70 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600 dark:border-slate-700 dark:bg-slate-800/70 dark:text-slate-300"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        AWS Certified Cloud Practitioner
      </span>
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white">
        Hi, I&rsquo;m <span class="text-indigo-600 dark:text-indigo-400">{site.name}</span>
      </h1>
      <p class="mt-4 text-xl font-medium text-slate-900 sm:text-2xl dark:text-slate-100">
        {site.role}
      </p>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {site.tagline}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex items-center justify-center rounded-lg bg-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-500"
        >
          View projects
        </a>
        <a
          href={site.socials.github.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-300 bg-white px-6 py-3 text-base font-semibold text-slate-700 hover:border-slate-400 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:text-white"
        >
          <Icon name="github" class="h-5 w-5" />
          GitHub profile
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <Section id="about" kicker="About" title="About me" description={site.bio[0]}>
    <div class="space-y-4 text-slate-600 dark:text-slate-400">
      {
        site.bio.slice(1).map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>
  </Section>

  <!-- Skills -->
  <Section
    id="skills"
    kicker="Skills"
    title="Skills & technologies"
    description="The languages, tools, and practices I work with across development, data, QA, and cloud."
    wide
    tint
  >
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-200">
              {group.category}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {
                group.skills.map((skill) => (
                  <li class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    {skill}
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Experience -->
  <Section
    id="experience"
    kicker="Career"
    title="Experience"
    description="A blend of software development, data management, QA, and cloud support roles."
    wide
  >
    <ol class="space-y-6">
      {
        experience.map((item) => (
          <li>
            <ExperienceCard experience={item} />
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Projects -->
  <Section
    id="projects"
    kicker="Portfolio"
    title="Projects"
    description="A growing showcase of my work. Cards show a source link once a repository becomes public."
    wide
    tint
  >
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
      More projects are on the way. Follow along on <a
        href={site.socials.github.href}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-slate-700 underline decoration-slate-300 underline-offset-2 hover:text-indigo-600 dark:text-slate-300 dark:decoration-slate-600 dark:hover:text-indigo-400"
      >GitHub</a>.
    </p>
  </Section>

  <!-- Education -->
  <Section
    id="education"
    kicker="Education"
    title="Education & certifications"
  >
    <ol class="space-y-4">
      {
        education.map((item) => (
          <li class="flex flex-col gap-1 rounded-2xl border border-slate-200 bg-white p-6 sm:flex-row sm:items-baseline sm:justify-between dark:border-slate-800 dark:bg-slate-900">
            <div>
              <h3 class="text-base font-semibold text-slate-900 dark:text-white">{item.qualification}</h3>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                {item.institution}{item.details ? ` — ${item.details}` : ""}
              </p>
            </div>
            <p class="shrink-0 text-sm font-medium text-slate-500 dark:text-slate-400">{item.period}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Contact -->
  <Section
    id="contact"
    kicker="Contact"
    title="Get in touch"
    description="Interested in collaborating or just want to say hello? Reach out through any of the channels below."
  >
    <ul class="space-y-3">
      <li>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-3 rounded-lg px-3 py-2 font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white"
        >
          <Icon name="mail" class="h-5 w-5 text-slate-400 dark:text-slate-500" />
          <span>{site.email}</span>
        </a>
      </li>
      <li>
        <a
          href={site.socials.github.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-lg px-3 py-2 font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white"
        >
          <Icon name="github" class="h-5 w-5 text-slate-400 dark:text-slate-500" />
          <span>{site.socials.github.href.replace(/^https?:\/\//, "")}</span>
        </a>
      </li>
      <li>
        <a
          href={site.socials.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-lg px-3 py-2 font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-800 dark:hover:text-white"
        >
          <Icon name="linkedin" class="h-5 w-5 text-slate-400 dark:text-slate-500" />
          <span>{site.socials.linkedin.href.replace(/^https?:\/\//, "")}</span>
        </a>
      </li>
    </ul>
    <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">Based in {site.location}.</p>
  </Section>
</BaseLayout>
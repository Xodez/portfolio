---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`${site.name} — ${site.role}`} description={site.tagline}>
  <section id="top" class="scroll-mt-24">
    <div class="mx-auto max-w-3xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        {site.name}
      </h1>
      <p class="mt-4 text-xl font-medium text-slate-900">{site.role}</p>
    </div>
  </section>
</BaseLayout>
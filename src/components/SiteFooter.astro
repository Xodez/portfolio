---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<footer class="border-t border-slate-200">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 py-10 sm:flex-row sm:px-6 lg:px-8">
    <p class="text-sm text-slate-500">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
    <ul class="flex items-center gap-2">
      <li>
        <a
          href={site.socials.github.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          aria-label={`GitHub profile of ${site.name}`}
        >
          <Icon name="github" class="h-4 w-4" />
          GitHub
        </a>
      </li>
      <li>
        <a
          href={site.socials.linkedin.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          aria-label={`LinkedIn profile of ${site.name}`}
        >
          <Icon name="linkedin" class="h-4 w-4" />
          LinkedIn
        </a>
      </li>
    </ul>
  </div>
</footer>
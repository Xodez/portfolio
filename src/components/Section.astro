---
interface Props {
  /** Unique anchor used by the section links in the nav. */
  id: string;
  title: string;
  kicker?: string;
  description?: string;
  /** Use a wider container for content such as project cards. */
  wide?: boolean;
  /** Alternate background band to give the page visual rhythm. */
  tint?: boolean;
}

const { id, title, kicker, description, wide = false, tint = false } = Astro.props;
const containerClass = wide ? "max-w-5xl" : "max-w-3xl";
---

<section id={id} class={`scroll-mt-20 ${tint ? "bg-slate-50 dark:bg-slate-900/60" : ""}`}>
  <div class={`mx-auto px-4 py-16 sm:px-6 sm:py-20 lg:px-8 ${containerClass}`}>
    {kicker && (
      <p class="flex items-center gap-3 text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
        <span class="h-px w-8 bg-indigo-500/70" aria-hidden="true"></span>
        {kicker}
      </p>
    )}
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
      {title}
    </h2>
    {description && (
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
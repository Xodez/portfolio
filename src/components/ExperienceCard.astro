---
import type { Experience } from "../types";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{experience.role}</h3>
    <p class="shrink-0 text-sm font-medium text-slate-500 dark:text-slate-400">{experience.period}</p>
  </div>
  <p class="mt-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">
    {experience.organization}{experience.location ? ` · ${experience.location}` : ""}
  </p>
  <p class="mt-3 text-base leading-relaxed text-slate-600 dark:text-slate-300">{experience.summary}</p>
  {
    experience.highlights.length > 0 && (
      <ul class="mt-4 list-disc space-y-2.5 pl-5 text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {
          experience.highlights.map((point) => (
            <li>{point}</li>
          ))
        }
      </ul>
    )
  }
</article>
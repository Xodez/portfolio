---
import type { Experience } from "../types";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-semibold text-slate-900">{experience.role}</h3>
    <p class="shrink-0 text-sm font-medium text-slate-500">{experience.period}</p>
  </div>
  <p class="mt-1 text-sm font-semibold text-indigo-600">
    {experience.organization}{experience.location ? ` · ${experience.location}` : ""}
  </p>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">{experience.summary}</p>
  {
    experience.highlights.length > 0 && (
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-600">
        {
          experience.highlights.map((point) => (
            <li>{point}</li>
          ))
        }
      </ul>
    )
  }
</article>
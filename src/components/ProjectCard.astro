---
import type { Project } from "../types";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusStyles: Record<
  Project["status"],
  { label: string; classes: string }
> = {
  active: {
    label: "Active",
    classes: "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
  },
  "in-progress": {
    label: "In progress",
    classes: "bg-amber-50 text-amber-700 ring-amber-600/20",
  },
  planned: {
    label: "Planned",
    classes: "bg-sky-50 text-sky-700 ring-sky-600/20",
  },
  archived: {
    label: "Archived",
    classes: "bg-slate-100 text-slate-600 ring-slate-500/20",
  },
};

const status = statusStyles[project.status];
---

<article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md">
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <h3 class="text-lg font-semibold text-slate-900">{project.name}</h3>
    <span
      class={`inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${status.classes}`}
    >
      {status.label}
    </span>
  </div>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{project.description}</p>
  {
    project.technologies.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies used">
        {
          project.technologies.map((tech) => (
            <li class="rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-700">
              {tech}
            </li>
          ))
        }
      </ul>
    )
  }
  <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-sm">
    {
      project.githubUrl ? (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-slate-700 hover:text-indigo-600"
        >
          <Icon name="github" class="h-4 w-4" />
          Source
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      ) : (
        <span
          class="inline-flex items-center gap-1.5 text-slate-500"
          title="Source code is not publicly available"
        >
          <Icon name="github" class="h-4 w-4" />
          Private
        </span>
      )
    }
    {
      project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-slate-700 hover:text-indigo-600"
        >
          Live demo
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      )
    }
  </div>
</article>
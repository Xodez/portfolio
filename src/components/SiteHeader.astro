---
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/80 backdrop-blur">
  <nav
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Primary"
  >
    <a href="#top" class="text-base font-bold tracking-tight text-slate-900 hover:text-indigo-600">
      {site.name}
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      <ul class="flex flex-wrap items-center justify-end gap-1 text-sm sm:gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-lg px-2.5 py-2 font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={site.socials.github.href}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-300 hover:text-slate-900"
        aria-label={`GitHub profile of ${site.name}`}
      >
        <Icon name="github" class="h-4 w-4" />
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>
  </nav>
</header>